# Docker Compose only: copy to private .env and replace the required blank values.
# Native dotnet processes do NOT read this file; see README.md for host environment setup.
ACCEPT_EULA=Y
MSSQL_PID=Developer
MSSQL_SA_PASSWORD=
RABBITMQ_DEFAULT_USER=ironbook
RABBITMQ_DEFAULT_PASS=
RABBITMQ_DEFAULT_VHOST=/

# Compose derives both application connection strings and broker credentials from the values above.
# Optional external-service overrides (leave commented for the bundled SQL Server/RabbitMQ):
# ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=190027;User Id=sa;Password=<private-password>;TrustServerCertificate=True;
# RabbitMQ__Host=rabbitmq
# RabbitMQ__Port=5672
# RabbitMQ__Username=ironbook
# RabbitMQ__Password=
# RabbitMQ__VirtualHost=/
RabbitMQ__QueueName=ironbook.member-notifications

# Private, distinct random JWT/QR values, each at least 32 UTF-8 bytes. Defaults/placeholders are rejected.
Jwt__Issuer=IronBook
Jwt__Audience=IronBookClients
Jwt__ExpirationMinutes=60
Jwt__SigningKey=
QrAccess__SigningKey=

# Local/demo defaults. Setting Production prevents all Development seed execution.
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
DemoSeed__Enabled=false
# Optional foundation-seeding selection ONLY when creating a missing evaluator Member account.
DevelopmentMember__MemberProfileId=

# Optional sandbox Card/refund support. Supply a private sk_test_ key locally, or leave blank for Reception.
Stripe__SecretKey=
# Flutter STRIPE_PUBLISHABLE_KEY is supplied with --dart-define, never as a backend secret here.
