ACCEPT_EULA=Y
MSSQL_SA_PASSWORD=Change_this_dev_password_123!
MSSQL_PID=Developer

RABBITMQ_DEFAULT_USER=ironbook
RABBITMQ_DEFAULT_PASS=change_this_rabbit_password

ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=190027;User Id=sa;Password=Change_this_dev_password_123!;TrustServerCertificate=True;
RabbitMQ__Host=rabbitmq
RabbitMQ__Port=5672
RabbitMQ__QueueName=ironbook.member-notifications
# Optional Development seeding-only selection when creating the evaluator Member account.
DevelopmentMember__MemberProfileId=
RabbitMQ__Username=ironbook
RabbitMQ__Password=change_this_rabbit_password
# JWT and QR keys must be private random values (at least 32 UTF-8 bytes).
# Generate distinct values locally; placeholders/defaults are rejected in ALL environments.
Jwt__Issuer=IronBook
Jwt__Audience=IronBookClients
Jwt__SigningKey=replace_with_a_long_local_development_key
QrAccess__SigningKey=replace_with_long_local_qr_access_signing_key_32_chars_minimum
# Sandbox Card checkout only. Configure locally; never commit a real test secret.
Stripe__SecretKey=replace_with_your_stripe_sandbox_secret_key
